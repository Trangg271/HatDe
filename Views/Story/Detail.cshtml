@model HatDe.Models.Story

@{
    ViewData["Title"] = Model.Title;
    var chapters = ViewBag.Chapters as List<HatDe.Models.Chapter>;
}

<div class="container mt-4">
    <div class="row">
        <!-- Cột trái: Ảnh bìa và nút affiliate -->
        <div class="col-md-4 text-center">
            <img src="@Model.CoverImageUrl" alt="@Model.Title" class="img-fluid rounded shadow-sm mb-3" style="max-height: 400px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/200x280?text=No+Image'" />
            
            @if (!string.IsNullOrEmpty(Model.AffiliateLink))
            {
                <div class="d-grid mb-3">
                    <a href="@Model.AffiliateLink" target="_blank" class="btn btn-warning fw-bold">🛒 Mua sách ủng hộ tác giả</a>
                </div>
            }

            <div class="d-grid">
                <a href="/Chapter/Add?storyId=@Model.Id" class="btn btn-outline-primary fw-bold">➕ Thêm Chương Mới</a>
            </div>
        </div>
        
        <!-- Cột phải: Thông tin chi tiết và danh sách chương -->
        <div class="col-md-8">
            <h2 class="fw-bold text-dark">@Model.Title</h2>
            <p class="text-muted fs-5">Tác giả: <span class="fw-semibold text-primary">@Model.Author</span></p>
            
            <hr />
            
            <h5 class="fw-bold">Giới thiệu nội dung</h5>
            <p style="white-space: pre-line; line-height: 1.6;">@(Model.Description ?? "Chưa có mô tả cho tác phẩm này.")</p>
            
            <hr />
            
            <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
                <h4 class="fw-bold m-0">Danh sách chương</h4>
            </div>

            <div class="list-group shadow-sm">
                @if (chapters != null && chapters.Any())
                {
                    foreach (var chap in chapters)
                    {
                        <a href="/Chapter/Read/@chap.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <span class="fw-medium">@chap.Title</span>
                            <div>
                                @if (chap.IsVip)
                                {
                                    <span class="badge bg-danger rounded-pill me-2">VIP - @chap.PriceInHatDe 🌰 Hạt Dẻ</span>
                                }
                                else
                                {
                                    <span class="badge bg-success rounded-pill me-2">Miễn phí</span>
                                }
                                <span class="text-muted small">Đọc ngay &rarr;</span>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div class="list-group-item text-muted py-3">Truyện này hiện chưa có chương nào được đăng. Hãy bấm "Thêm Chương Mới" để bắt đầu!</div>
                }
            </div>
        </div>
    </div>
</div>
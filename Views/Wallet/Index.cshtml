@model HatDe.Models.User

@{
    ViewData["Title"] = "Ví Hạt Dẻ";
}

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow-sm border-0 p-4 bg-white">
        <div class="text-center mb-4">
            <span style="font-size: 50px;">🌰</span>
            <h2 class="fw-bold text-dark mt-2">Ví Hạt Dẻ Của Bạn</h2>
            <p class="text-muted">Quản lý số dư và nạp thêm Hạt dẻ để tiếp tục mở khóa các chương truyện VIP.</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="p-4 mb-4 rounded bg-light text-center border">
            <span class="text-muted d-block mb-1">Số dư hiện tại</span>
            <h1 class="fw-bold text-danger m-0">@Model.HatDeBalance 🌰 Hạt Dẻ</h1>
        </div>

        <!-- Khung Nhập Giftcode -->
        <h5 class="fw-bold mb-2">Nhập mã Giftcode:</h5>
        <form asp-action="RedeemCode" method="post" class="mb-4">
            <div class="input-group">
                <input type="text" name="codeInput" class="form-control" placeholder="Nhập mã quà tặng của bạn..." required />
                <button type="submit" class="btn btn-dark fw-bold px-4">Đổi Mã</button>
            </div>
        </form>

        <h5 class="fw-bold mb-3">Chọn gói nạp nhanh:</h5>
        <form asp-action="Deposit" method="post">
            <div class="row g-2 mb-3">
                <div class="col-4">
                    <button type="submit" name="amount" value="50" class="btn btn-outline-primary w-100 py-3 fw-bold">+ 50 🌰<br><small class="text-muted">5,000đ</small></button>
                </div>
                <div class="col-4">
                    <button type="submit" name="amount" value="100" class="btn btn-outline-primary w-100 py-3 fw-bold">+ 100 🌰<br><small class="text-muted">10,000đ</small></button>
                </div>
                <div class="col-4">
                    <button type="submit" name="amount" value="500" class="btn btn-outline-danger w-100 py-3 fw-bold">+ 500 🌰<br><small class="text-muted">50,000đ</small></button>
                </div>
            </div>
        </form>

        <div class="mt-3 text-center">
            <a href="/" class="text-decoration-none text-muted">&larr; Quay lại trang chủ đọc truyện</a>
        </div>
    </div>
</div>
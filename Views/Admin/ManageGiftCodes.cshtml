@model IEnumerable<HatDe.Models.GiftCode>

@{
    ViewData["Title"] = "Quản Lý Giftcode";
}

<div class="container mt-4" style="max-width: 800px;">
    <h2 class="fw-bold text-primary mb-4">🎁 Quản Lý Mã Quà Tặng (Giftcode)</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- Form tạo mã mới -->
    <div class="card shadow-sm border-0 mb-4 bg-white">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">Tạo Mã Giftcode Mới</h5>
            <form asp-action="CreateGiftCode" method="post" class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Mã Code</label>
                    <input type="text" name="code" class="form-control" placeholder="Ví dụ: HATDE2026" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Số Hạt Dẻ Thưởng</label>
                    <input type="number" name="rewardAmount" class="form-control" value="50" min="1" required />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-success w-100 fw-bold">Tạo Mã</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách mã đã tạo -->
    <div class="card shadow-sm border-0 bg-white">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">Danh Sách Mã Đã Phát Hành</h5>
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã Code</th>
                        <th>Phần Thưởng</th>
                        <th>Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@item.Code</td>
                                <td><span class="text-danger fw-bold">@item.RewardAmount 🌰</span></td>
                                <td>
                                    @if (item.IsUsed)
                                    {
                                        <span class="badge bg-secondary">Đã sử dụng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Còn hiệu lực</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-3">Chưa có mã Giftcode nào được tạo.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="mt-3">
        <a href="/" class="text-decoration-none text-muted">&larr; Quay lại trang chủ</a>
    </div>
</div>
@model HatDe.Models.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký";
}

<div class="account-shell">
    <div class="account-card">
        <div class="account-icon" aria-hidden="true">🐿</div>
        <p class="account-kicker">GIA NHẬP KHU RỪNG</p>
        <h1>Đăng ký</h1>
        <p class="account-intro">Cất giữ truyện yêu thích và nhận 100 Hạt Dẻ cho chuyến đọc đầu tiên.</p>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label">Tên tài khoản</label>
                <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Mật khẩu</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Bắt đầu hành trình</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
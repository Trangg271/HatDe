@model HatDe.Models.Chapter

@{
    ViewData["Title"] = "Chương VIP";
    var story = ViewBag.Story as HatDe.Models.Story;
}

<div class="container mt-5 text-center" style="max-width: 600px;">
    <div class="card shadow-sm p-5 border-0 bg-white">
        <div class="mb-3">
            <span style="font-size: 50px;">🔒</span>
        </div>
        <h3 class="fw-bold text-danger">Chương Truyện Giới Hạn (VIP)</h3>
        <p class="text-muted">Chương <strong>@Model.Title</strong> của tác phẩm <em>@(story?.Title)</em> yêu cầu sử dụng Hạt Dẻ để mở khóa nội dung.</p>
        
        <div class="alert alert-warning my-3 text-start">
            <div class="d-flex justify-content-between mb-1">
                <span>Phí mở khóa:</span>
                <span class="fw-bold text-danger">@Model.PriceInHatDe 🌰 Hạt Dẻ</span>
            </div>
            <div class="d-flex justify-content-between">
                <span>Ví hiện tại:</span>
                <span class="fw-bold text-success">@ViewBag.UserBalance 🌰 Hạt Dẻ</span>
            </div>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger py-2">@TempData["Error"]</div>
        }

        <form asp-action="Unlock" method="post" class="mt-3">
            <input type="hidden" name="chapterId" value="@Model.Id" />
            <button type="submit" class="btn btn-danger btn-lg fw-bold w-100 py-2">Xác nhận mở khóa (-@Model.PriceInHatDe 🌰)</button>
        </form>

        <div class="mt-4">
            <a href="/Story/Detail/@Model.StoryId" class="text-decoration-none text-muted">&larr; Quay lại danh sách chương</a>
        </div>
    </div>
</div>
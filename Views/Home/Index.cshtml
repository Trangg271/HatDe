@model IEnumerable<HatDe.Models.Story>

@{
    ViewData["Title"] = "Trang Chủ";
}

<div class="story-container">
    @if (User.Identity?.IsAuthenticated != true)
    {
        <section class="platform-intro">
            <div class="intro-mascot" aria-hidden="true">🐿</div>
            <p class="account-kicker">KHU RỪNG HẠT DẺ</p>
            <h1>Những câu chuyện được cất giữ thật dịu dàng.</h1>
            <p>Nền tảng đọc truyện cá nhân hóa, nơi mỗi chương truyện là một hạt dẻ nhỏ dành riêng cho hành trình của bạn.</p>
            <div class="intro-actions">
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Đăng nhập</a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary">Đăng ký</a>
            </div>
        </section>
    }
    else
    {
        <div class="welcome-note">
            <span aria-hidden="true">🐿</span>
            <p>Nơi chú sóc cất giữ những chương truyện ấm áp dưới tán cây hạt dẻ.</p>
        </div>
        <h2>Truyện Mới Cập Nhật</h2>

        <div class="story-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var story in Model)
            {
                <div class="story-card">
                    <!-- Ảnh bìa truyện -->
                    <img src="@story.CoverImageUrl" alt="@story.Title" class="story-cover" />
                    
                    <div class="story-info">
                        <h3>@story.Title</h3>
                        <p class="author">Tác giả: @story.Author</p>
                        
                        <!-- Nút đọc truyện -->
                        <a href="/Story/Detail/@story.Id" class="btn-read">Đọc ngay</a>

                        <form asp-controller="Admin" asp-action="DeleteStory" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@story.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                    onclick="return confirm('Bạn có chắc muốn xóa truyện này không?');">
                                Xóa truyện
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <p>Hiện chưa có bộ truyện nào.</p>
        }
        </div>
    }
</div>